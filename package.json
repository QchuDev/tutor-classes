{
  "name": "tutor-classes",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build --filter=!@ppts/template",
    "build:site": "turbo run build --filter=!@ppts/template && node scripts/assemble-site.mjs",
    "new-ppt": "node scripts/new-ppt.mjs",
    "clean": "turbo run clean && rm -rf dist"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.6.0"
  }
}
